# Measurement runs are local by default. Historical checkpoints are admitted
# deliberately so a new label cannot enter a release unnoticed.
Metrics/*.json
!Metrics/baseline.json
!Metrics/optimized.json
!Metrics/features.json
!Metrics/quality.json
!Metrics/branding.json
!Metrics/alternate-icon.json
