#include "XSCBase.h"

#include <dirent.h>
#include <errno.h>
#include <limits.h>
#include <pthread.h>
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <time.h>
#include <unistd.h>

#pragma mark - XSCObject

@implementation XSCObject

+ (instancetype)alloc {
#if defined(__APPLE__)
    return (__bridge_transfer id)objc3_darwin_allocate_v1((__bridge const objc3_darwin_class *)self);
#else
    return class_createInstance(self, 0);
#endif
}

+ (instancetype)new {
    return [[self alloc] init];
}

- (instancetype)init {
    return self;
}

- (void)dealloc {
#if !defined(__APPLE__)
    object_dispose(self);
#endif
}

@end

#pragma mark - XSCString

@implementation XSCString {
    char *_storage;
    size_t _length;
}

- (const char *)utf8 {
    return _storage ? _storage : "";
}

- (size_t)length {
    return _length;
}

+ (instancetype)emptyString {
    return [self stringWithBytes:"" length:0];
}

+ (instancetype)stringWithUTF8:(const char *)utf8 {
    if (!utf8) return [self emptyString];
    return [self stringWithBytes:utf8 length:strlen(utf8)];
}

+ (instancetype)stringWithBytes:(const char *)bytes length:(size_t)length {
    if (length == SIZE_MAX) return nil;
    XSCString *s = [[self alloc] init];
    if (!s) return nil;
    char *buf = (char *)malloc(length + 1u);
    if (!buf) return nil;
    if (length > 0u && bytes) {
        memcpy(buf, bytes, length);
    }
    buf[length] = '\0';
    s->_storage = buf;
    s->_length = length;
    return s;
}

+ (instancetype)stringWithFormat:(const char *)fmt, ... {
    if (!fmt) return [self emptyString];
    va_list ap1;
    va_start(ap1, fmt);
    va_list ap2;
    va_copy(ap2, ap1);
    int needed = vsnprintf(NULL, 0, fmt, ap1);
    va_end(ap1);
    if (needed < 0) {
        va_end(ap2);
        return [self emptyString];
    }
    size_t len = (size_t)needed;
    char *buf = (char *)malloc(len + 1u);
    if (!buf) {
        va_end(ap2);
        return [self emptyString];
    }
    vsnprintf(buf, len + 1u, fmt, ap2);
    va_end(ap2);

    XSCString *s = [[self alloc] init];
    if (!s) {
        free(buf);
        return nil;
    }
    s->_storage = buf;
    s->_length = len;
    return s;
}

- (void)dealloc {
    free(_storage);
    _storage = NULL;
    _length = 0u;
}

- (bool)isEqualToString:(XSCString *)other {
    if (self == other) return true;
    if (!other) return false;
    if (_length != other->_length) return false;
    if (_length == 0u) return true;
    return memcmp(self.utf8, other.utf8, _length) == 0;
}

- (bool)isEqualToUTF8:(const char *)utf8 {
    if (!utf8) return false;
    size_t otherLen = strlen(utf8);
    if (_length != otherLen) return false;
    if (_length == 0u) return true;
    return memcmp(self.utf8, utf8, _length) == 0;
}

- (bool)hasPrefixUTF8:(const char *)prefix {
    if (!prefix) return false;
    size_t pLen = strlen(prefix);
    if (pLen > _length) return false;
    if (pLen == 0u) return true;
    return memcmp(self.utf8, prefix, pLen) == 0;
}

- (bool)hasSuffixUTF8:(const char *)suffix {
    if (!suffix) return false;
    size_t sLen = strlen(suffix);
    if (sLen > _length) return false;
    if (sLen == 0u) return true;
    return memcmp(self.utf8 + (_length - sLen), suffix, sLen) == 0;
}

- (XSCString *)lastPathComponent {
    const char *s = self.utf8;
    size_t len = _length;
    while (len > 1u && s[len - 1u] == '/') {
        len--;
    }
    if (len == 0u) return [XSCString emptyString];
    if (len == 1u && s[0] == '/') return [XSCString stringWithBytes:"/" length:1u];
    size_t i = len;
    while (i > 0u && s[i - 1u] != '/') {
        i--;
    }
    return [XSCString stringWithBytes:s + i length:len - i];
}

- (XSCString *)stringByDeletingLastPathComponent {
    const char *s = self.utf8;
    size_t len = _length;
    while (len > 1u && s[len - 1u] == '/') {
        len--;
    }
    if (len == 0u) return [XSCString emptyString];
    size_t i = len;
    while (i > 0u && s[i - 1u] != '/') {
        i--;
    }
    if (i == 0u) return [XSCString emptyString];
    while (i > 1u && s[i - 1u] == '/') {
        i--;
    }
    return [XSCString stringWithBytes:s length:i];
}

- (XSCString *)stringByAppendingPathComponent:(const char *)component {
    if (!component || component[0] == '\0') return self;
    while (*component == '/') component++;
    size_t cLen = strlen(component);
    if (cLen == 0u) return self;
    if (_length == 0u) return [XSCString stringWithBytes:component length:cLen];
    const char *s = self.utf8;
    bool hasSlash = (s[_length - 1u] == '/');
    size_t extra = (hasSlash ? 0u : 1u) + 1u;
    if (_length > SIZE_MAX - extra || cLen > SIZE_MAX - _length - extra) {
        return [XSCString emptyString];
    }
    size_t total = _length + (hasSlash ? 0u : 1u) + cLen;
    char *buf = (char *)malloc(total + 1u);
    if (!buf) return [XSCString emptyString];
    memcpy(buf, s, _length);
    size_t pos = _length;
    if (!hasSlash) buf[pos++] = '/';
    memcpy(buf + pos, component, cLen);
    buf[total] = '\0';

    XSCString *out = [[XSCString alloc] init];
    if (!out) {
        free(buf);
        return [XSCString emptyString];
    }
    out->_storage = buf;
    out->_length = total;
    return out;
}

@end

#pragma mark - XSCData

@implementation XSCData {
    uint8_t *_storage;
    size_t _length;
}

- (const uint8_t *)bytes {
    return _storage;
}

- (size_t)length {
    return _length;
}

+ (instancetype)emptyData {
    return [[self alloc] init];
}

+ (instancetype)dataWithBytes:(const void *)bytes length:(size_t)length {
    if (length == 0u) return [self emptyData];
    uint8_t *buf = (uint8_t *)malloc(length);
    if (!buf) return nil;
    if (bytes) {
        memcpy(buf, bytes, length);
    } else {
        memset(buf, 0, length);
    }
    return [self dataTakingBytesNoCopy:buf length:length];
}

+ (instancetype)dataTakingBytesNoCopy:(void *)bytes length:(size_t)length {
    XSCData *d = [[self alloc] init];
    if (!d) {
        free(bytes);
        return nil;
    }
    d->_storage = (uint8_t *)bytes;
    d->_length = bytes ? length : 0u;
    return d;
}

- (void)dealloc {
    free(_storage);
    _storage = NULL;
    _length = 0u;
}

- (bool)isEqualToData:(XSCData *)other {
    if (self == other) return true;
    if (!other) return false;
    if (_length != other->_length) return false;
    if (_length == 0u) return true;
    return memcmp(_storage, other->_storage, _length) == 0;
}

@end

#pragma mark - XSCError

@implementation XSCError {
    XSCErrorDomain _domain;
    int _code;
    XSCString *_message;
}

- (XSCErrorDomain)domain { return _domain; }
- (int)code { return _code; }
- (XSCString *)message { return _message ? _message : [XSCString emptyString]; }

+ (instancetype)errorWithDomain:(XSCErrorDomain)domain code:(int)code message:(const char *)utf8 {
    return [self errorWithDomain:domain code:code string:[XSCString stringWithUTF8:utf8 ? utf8 : ""]];
}

+ (instancetype)errorWithDomain:(XSCErrorDomain)domain code:(int)code string:(XSCString *)message {
    XSCError *err = [[self alloc] init];
    if (!err) return nil;
    err->_domain = domain;
    err->_code = code;
    err->_message = message ? message : [XSCString emptyString];
    return err;
}

@end

#pragma mark - XSCIndexList

@implementation XSCIndexList {
    size_t *_values;
    size_t _count;
}

- (size_t)count { return _count; }
- (const size_t *)values { return _values; }

+ (instancetype)emptyList {
    return [[self alloc] init];
}

+ (instancetype)listWithValues:(const size_t *)values count:(size_t)count {
    if (count == 0u || !values || count > SIZE_MAX / sizeof(size_t)) return [self emptyList];
    size_t *buf = (size_t *)malloc(count * sizeof(size_t));
    if (!buf) return [self emptyList];
    memcpy(buf, values, count * sizeof(size_t));
    XSCIndexList *list = [[self alloc] init];
    if (!list) {
        free(buf);
        return nil;
    }
    list->_values = buf;
    list->_count = count;
    return list;
}

- (void)dealloc {
    free(_values);
    _values = NULL;
    _count = 0u;
}

- (size_t)valueAtIndex:(size_t)index {
    if (index >= _count) return 0u;
    return _values[index];
}

- (bool)containsValue:(size_t)value {
    for (size_t i = 0u; i < _count; i++) {
        if (_values[i] == value) return true;
    }
    return false;
}

@end

#pragma mark - Monotonic Clock

uint64_t xsc_now_ns(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
}

double xsc_now_ms(void) {
    return (double)xsc_now_ns() / 1e6;
}

#pragma mark - Main-Thread Queue & Timers

@interface XSCQueueItem : XSCObject {
@public
    XSCVoidBlock _block;
    uint64_t _dueNs;
    XSCQueueItem *_next;
}
@end

@implementation XSCQueueItem
@end

static pthread_t gMainThread;
static _Atomic(bool) gMainThreadMarked = false;
static pthread_mutex_t gMainMutex = PTHREAD_MUTEX_INITIALIZER;
#if defined(__APPLE__)
static pthread_cond_t gMainCond = PTHREAD_COND_INITIALIZER;
#else
static pthread_cond_t gMainCond;
static bool gMainCondInit = false;
#endif
static XSCQueueItem *gMainHead = nil;
static XSCQueueItem *gMainTail = nil;
static XSCQueueItem *gTimerHead = nil;
static void (*gMainWakeupFn)(void) = NULL;

static void xsc_ensure_main_cond_locked(void) {
#if !defined(__APPLE__)
    if (gMainCondInit) return;
    pthread_condattr_t attr;
    pthread_condattr_init(&attr);
    defer { pthread_condattr_destroy(&attr); }
    pthread_condattr_setclock(&attr, CLOCK_MONOTONIC);
    pthread_cond_init(&gMainCond, &attr);
    gMainCondInit = true;
#endif
}

void xsc_mark_main_thread(void) {
    if (atomic_load_explicit(&gMainThreadMarked, memory_order_acquire)) {
        return;
    }
    gMainThread = pthread_self();
    atomic_store_explicit(&gMainThreadMarked, true, memory_order_release);
}

bool xsc_is_main_thread(void) {
    if (!atomic_load_explicit(&gMainThreadMarked, memory_order_acquire)) {
        return true;
    }
    return pthread_equal(pthread_self(), gMainThread) != 0;
}

void xsc_set_main_wakeup(void (*wakeup_fn)(void)) {
    pthread_mutex_lock(&gMainMutex);
    defer { pthread_mutex_unlock(&gMainMutex); }
    gMainWakeupFn = wakeup_fn;
}

void xsc_dispatch_main(XSCVoidBlock block) {
    if (!block) return;
    XSCQueueItem *item = [[XSCQueueItem alloc] init];
    if (!item) return;
    item->_block = block;
    item->_dueNs = 0ULL;
    item->_next = nil;

    void (*wakeup)(void) = NULL;
    {
        pthread_mutex_lock(&gMainMutex);
        defer { pthread_mutex_unlock(&gMainMutex); }
        xsc_ensure_main_cond_locked();
        if (gMainTail) {
            gMainTail->_next = item;
            gMainTail = item;
        } else {
            gMainHead = item;
            gMainTail = item;
        }
        wakeup = gMainWakeupFn;
        pthread_cond_broadcast(&gMainCond);
    }
    if (wakeup) {
        wakeup();
    }
}

void xsc_dispatch_main_after_ms(uint64_t delay_ms, XSCVoidBlock block) {
    if (!block) return;
    if (delay_ms == 0ULL) {
        xsc_dispatch_main(block);
        return;
    }
    XSCQueueItem *item = [[XSCQueueItem alloc] init];
    if (!item) return;
    item->_block = block;
    uint64_t now = xsc_now_ns();
    item->_dueNs = (delay_ms > (UINT64_MAX - now) / 1000000ULL)
        ? UINT64_MAX
        : (now + delay_ms * 1000000ULL);
    item->_next = nil;

    void (*wakeup)(void) = NULL;
    {
        pthread_mutex_lock(&gMainMutex);
        defer { pthread_mutex_unlock(&gMainMutex); }
        xsc_ensure_main_cond_locked();
        if (!gTimerHead || item->_dueNs < gTimerHead->_dueNs) {
            item->_next = gTimerHead;
            gTimerHead = item;
        } else {
            XSCQueueItem *cur = gTimerHead;
            while (cur->_next && cur->_next->_dueNs <= item->_dueNs) {
                cur = cur->_next;
            }
            item->_next = cur->_next;
            cur->_next = item;
        }
        wakeup = gMainWakeupFn;
        pthread_cond_broadcast(&gMainCond);
    }
    if (wakeup) {
        wakeup();
    }
}

size_t xsc_main_drain(void) {
    size_t ran = 0u;
    for (;;) {
        XSCQueueItem *readyHead = nil;
        XSCQueueItem *readyTail = nil;
        {
            pthread_mutex_lock(&gMainMutex);
            defer { pthread_mutex_unlock(&gMainMutex); }
            if (gMainHead) {
                readyHead = gMainHead;
                readyTail = gMainTail;
                gMainHead = nil;
                gMainTail = nil;
            }
            uint64_t now = xsc_now_ns();
            while (gTimerHead && gTimerHead->_dueNs <= now) {
                XSCQueueItem *t = gTimerHead;
                gTimerHead = t->_next;
                t->_next = nil;
                if (readyTail) {
                    readyTail->_next = t;
                    readyTail = t;
                } else {
                    readyHead = t;
                    readyTail = t;
                }
            }
        }
        if (!readyHead) break;
        XSCQueueItem *cur = readyHead;
        while (cur) {
            XSCQueueItem *next = cur->_next;
            cur->_next = nil;
            XSCVoidBlock blk = cur->_block;
            cur->_block = nil;
            if (blk) {
                @autoreleasepool {
                    blk();
                }
                ran++;
            }
            cur = next;
        }
    }
    return ran;
}

uint64_t xsc_main_next_deadline_ms(void) {
    pthread_mutex_lock(&gMainMutex);
    defer { pthread_mutex_unlock(&gMainMutex); }
    if (gMainHead) return 0u;
    if (!gTimerHead) return UINT64_MAX;
    uint64_t due = gTimerHead->_dueNs;
    return due / 1000000u + (due % 1000000u != 0u);
}

bool xsc_main_wait_ms(uint64_t timeout_ms) {
    if (xsc_main_drain() > 0u) return true;
    uint64_t startNs = xsc_now_ns();
    uint64_t deadlineNs = (timeout_ms > (UINT64_MAX - startNs) / 1000000ULL)
        ? UINT64_MAX
        : (startNs + timeout_ms * 1000000ULL);
    {
        pthread_mutex_lock(&gMainMutex);
        defer { pthread_mutex_unlock(&gMainMutex); }
        xsc_ensure_main_cond_locked();
        if (!gMainHead) {
            uint64_t waitUntil = deadlineNs;
            if (gTimerHead && gTimerHead->_dueNs < waitUntil) {
                waitUntil = gTimerHead->_dueNs;
            }
            uint64_t now = xsc_now_ns();
            if (waitUntil > now) {
#if defined(__APPLE__)
                uint64_t remaining = waitUntil - now;
                struct timespec relative = {
                    .tv_sec = (time_t)(remaining / 1000000000ULL),
                    .tv_nsec = (long)(remaining % 1000000000ULL),
                };
                pthread_cond_timedwait_relative_np(&gMainCond, &gMainMutex, &relative);
#else
                struct timespec ts;
                ts.tv_sec = (time_t)(waitUntil / 1000000000ULL);
                ts.tv_nsec = (long)(waitUntil % 1000000000ULL);
                pthread_cond_timedwait(&gMainCond, &gMainMutex, &ts);
#endif
            }
        }
    }
    return xsc_main_drain() > 0u;
}

#pragma mark - Background Worker Pool

static const int kXSCBgWorkerCount = 4;
static pthread_mutex_t gBgMutex = PTHREAD_MUTEX_INITIALIZER;
static pthread_cond_t gBgCond = PTHREAD_COND_INITIALIZER;
static pthread_t gBgThreads[4];
static int gBgActiveWorkers = 0;
static bool gBgStarted = false;
static bool gBgStop = false;
static XSCQueueItem *gBgHead = nil;
static XSCQueueItem *gBgTail = nil;

static void *xsc_bg_worker_main(void *arg) {
    (void)arg;
    for (;;) {
        @autoreleasepool {
            XSCQueueItem *item = nil;
            {
                pthread_mutex_lock(&gBgMutex);
                defer { pthread_mutex_unlock(&gBgMutex); }
                while (!gBgHead && !gBgStop) {
                    pthread_cond_wait(&gBgCond, &gBgMutex);
                }
                if (gBgStop && !gBgHead) {
                    return NULL;
                }
                item = gBgHead;
                gBgHead = item->_next;
                if (!gBgHead) gBgTail = nil;
                item->_next = nil;
            }
            if (item && item->_block) {
                XSCVoidBlock blk = item->_block;
                item->_block = nil;
                blk();
            }
        }
    }
}

static bool xsc_bg_ensure_started_locked(void) {
    if (gBgStarted) return gBgActiveWorkers > 0;
    gBgStop = false;
    gBgActiveWorkers = 0;
    for (int i = 0; i < kXSCBgWorkerCount; i++) {
        if (pthread_create(&gBgThreads[gBgActiveWorkers], NULL, xsc_bg_worker_main, NULL) == 0) {
            gBgActiveWorkers++;
        }
    }
    if (gBgActiveWorkers == 0) {
        return false;
    }
    gBgStarted = true;
    return true;
}

void xsc_dispatch_bg(XSCVoidBlock block) {
    if (!block) return;
    XSCQueueItem *item = [[XSCQueueItem alloc] init];
    if (!item) return;
    item->_block = block;
    item->_next = nil;

    bool fallbackInline = false;
    {
        pthread_mutex_lock(&gBgMutex);
        defer { pthread_mutex_unlock(&gBgMutex); }
        if (!xsc_bg_ensure_started_locked()) {
            fallbackInline = true;
        } else {
            if (gBgTail) {
                gBgTail->_next = item;
                gBgTail = item;
            } else {
                gBgHead = item;
                gBgTail = item;
            }
            pthread_cond_signal(&gBgCond);
        }
    }
    if (fallbackInline) {
        @autoreleasepool {
            block();
        }
    }
}

void xsc_dispatch_bg_shutdown(void) {
    int countToJoin = 0;
    pthread_t toJoin[4];
    {
        pthread_mutex_lock(&gBgMutex);
        defer { pthread_mutex_unlock(&gBgMutex); }
        if (gBgStarted) {
            gBgStop = true;
            countToJoin = gBgActiveWorkers;
            for (int i = 0; i < countToJoin; i++) {
                toJoin[i] = gBgThreads[i];
            }
            pthread_cond_broadcast(&gBgCond);
        }
    }
    if (countToJoin > 0) {
        for (int i = 0; i < countToJoin; i++) {
            pthread_join(toJoin[i], NULL);
        }
        pthread_mutex_lock(&gBgMutex);
        defer { pthread_mutex_unlock(&gBgMutex); }
        gBgActiveWorkers = 0;
        gBgStarted = false;
        gBgStop = false;
    }
}

#pragma mark - POSIX Recursive Removal

static void xsc_remove_tree_depth(const char *path, int depth) {
    if (!path || path[0] == '\0' || depth > 64) return;
    struct stat st;
    if (lstat(path, &st) != 0) return;
    if (!S_ISDIR(st.st_mode)) {
        unlink(path);
        return;
    }
    DIR *dir = opendir(path);
    if (!dir) {
        rmdir(path);
        return;
    }
    {
        defer { closedir(dir); }
        struct dirent *ent = NULL;
        while ((ent = readdir(dir)) != NULL) {
            if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0) {
                continue;
            }
            char child[PATH_MAX];
            int n = snprintf(child, sizeof(child), "%s/%s", path, ent->d_name);
            if (n > 0 && (size_t)n < sizeof(child)) {
                xsc_remove_tree_depth(child, depth + 1);
            }
        }
    }
    rmdir(path);
}

void xsc_remove_tree(const char *path) {
    xsc_remove_tree_depth(path, 0);
}
