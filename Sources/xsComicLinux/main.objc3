typedef struct XSCColor {
    float r, g, b, a;
} XSCColor;

static inline XSCColor xsc_rgba(uint8_t r, uint8_t g, uint8_t b, float a) {
    return (XSCColor){ (float)r / 255.0f, (float)g / 255.0f, (float)b / 255.0f, a };
}

static inline XSCColor xsc_rgb(uint8_t r, uint8_t g, uint8_t b) {
    return xsc_rgba(r, g, b, 1.0f);
}

static inline bool xsc_pt_in_rect(float px, float py, XSCRectF r) {
    return px >= r.x && px < (r.x + r.width) && py >= r.y && py < (r.y + r.height);
}

